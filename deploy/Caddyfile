# Host Caddy terminates TLS → Docker frontend (nginx) on loopback :18080 only.
# Backend FastAPI stays on Docker network opspilot-backend:8000 (not published on host :8000).
# Deploy: merge this global + site block into /etc/caddy/Caddyfile, then `sudo caddy validate --config ...` and `sudo systemctl reload caddy`.
{
	email hostmaster@appfinityhub.com
}

opspilot.appfinityhub.com {
	encode gzip

	reverse_proxy 127.0.0.1:18080 {
		transport http {
			dial_timeout 30s
			read_timeout 86400s
			write_timeout 86400s
		}
	}
}
