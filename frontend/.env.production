# Production
VITE_USER_NODE_ENV = production

VITE_GLOB_APP_TITLE = OpsPilot
VITE_PORT = 8848
VITE_OPEN = false
VITE_REPORT = false
VITE_DEVTOOLS = false
VITE_PROXY = []
VITE_CODE_INSPECTOR = false

# Public base path
VITE_PUBLIC_PATH = /

# Router mode
# Optional: hash | history
VITE_ROUTER_MODE = hash

# Build compression: gzip, brotli, comma-separated, or none
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS = none

# Delete original assets after gzip/brotli
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# Strip console.* in build when true
VITE_DROP_CONSOLE = true

# Enable Vite PWA plugin
VITE_PWA = true

# Backend origin only (no /api/v1).
# Same host as the SPA (nginx proxies /api → backend): omit VITE_API_URL — the client uses the page origin at runtime.
# Separate API host: set at build time, e.g. VITE_API_URL=https://api.yourdomain.com pnpm run build
